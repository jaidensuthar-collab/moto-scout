# ─────────────────────────────────────────────────────────────
# moto-scout configuration
# Copy to `.env` and fill in.  NEVER commit the real .env.
#   cp .env.example .env && chmod 600 .env
# No Facebook password lives here, or anywhere else in this repo.
# ─────────────────────────────────────────────────────────────

# ── Helper service ────────────────────────────────────────────
# Port the local helper API listens on. n8n calls this.
PORT=8477
# Bind address. Keep 127.0.0.1 so nothing outside your Mac can reach it.
HOST=127.0.0.1
# Shared secret. n8n must send it as the  X-Scout-Key  header.
# Generate one:  openssl rand -hex 24
SCOUT_API_KEY=

# ── Browser (your existing logged-in Opera) ──────────────────
# CDP endpoint of the Opera you already use and are already logged into.
# Opera must be launched from the wrapper at ~/Applications/Opera.app,
# which passes --remote-debugging-port=9222.
# We attach to that session. We never handle your Facebook credentials.
CDP_URL=http://127.0.0.1:9222
# Reuse an existing Facebook tab if one is open, else open a new one.
REUSE_EXISTING_TAB=true

# ── Search ────────────────────────────────────────────────────
# Reference point for all distance math. Neighborhood-level only --
# deliberately NOT your street address.
HOME_LAT=30.3799
HOME_LON=-97.9028
HOME_LABEL=Steiner Ranch, Austin, TX

# Search centroids. Default is now austin,sanantonio at 100 mi (below): five
# cities at 80 mi was mostly overlap, cost 30 searches per sweep instead of 12,
# and pulled in statewide results that were only rejected on distance anyway.
SEARCH_CITIES=austin,sanantonio
# Radius for each search, in miles (Facebook takes it in km; converted for you).
# Verified: 129 -> "Within 80 mi", 161 -> "Within 100 mi".
SEARCH_RADIUS_MILES=100
# Hard ceiling passed to Facebook's own price filter
SEARCH_MAX_PRICE=4500

# ── Politeness / rate limiting ───────────────────────────────
# Milliseconds between search page loads
DELAY_BETWEEN_SEARCHES_MS=9000
# Milliseconds between opening individual listings
DELAY_BETWEEN_LISTINGS_MS=6000
# Random extra jitter added to every delay (0..N ms)
DELAY_JITTER_MS=4000
# Max listings opened per run. Protects against runaway sessions.
MAX_LISTINGS_PER_RUN=25
# Max consecutive failures before the run aborts and logs
MAX_CONSECUTIVE_FAILURES=4
# Hard ceiling on how long one /run sweep can take. Checked at the top of
# every search and every listing-open; a run past this returns whatever it
# found instead of continuing. 22 min by default because stage 1 alone (25
# searches in test mode) measured 16+ minutes on real runs -- a tighter cap
# would cut every run off before it ever opens a listing. The n8n workflow's
# own HTTP Request timeout on the /run node must stay ABOVE this value or
# n8n will abort the connection while the server keeps working regardless.
MAX_SWEEP_MINUTES=22

# ── Google Sheets ─────────────────────────────────────────────
# Create the spreadsheet yourself, paste its ID here (the long string in the URL)
SHEET_ID=
# Path to a Google service-account JSON key.
# Keep it OUTSIDE this repo. chmod 600.
# Share the spreadsheet with the service account's client_email as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=/Users/Jaiden/.config/moto-scout/google-sa.json

# ── AI (optional; used for photo + description analysis) ─────
# Leave AI_PROVIDER empty to run fully heuristic with no AI calls.
# Supported: openai | anthropic | groq | (empty)
AI_PROVIDER=
AI_API_KEY=
# Vision-capable model. Only used when AI_PROVIDER is set.
AI_VISION_MODEL=gpt-4o-mini
# Hard cap on photo-analysis calls per run, so costs stay bounded
MAX_VISION_CALLS_PER_RUN=10

# ── Behaviour ─────────────────────────────────────────────────
# TEST MODE: no Facebook saves, writes to _TEST sheet tabs, caps results,
# and logs every action. Start here.
TEST_MODE=true
# Save qualifying listings using Facebook's Save button
ENABLE_FACEBOOK_SAVE=false
# Notifications are architected but intentionally off.
ENABLE_NOTIFICATIONS=false

# ── Storage ───────────────────────────────────────────────────
DB_PATH=./data/scout.db
LOG_PATH=./logs
# How often (hours) to refresh the cached model/year research
MODEL_CACHE_TTL_HOURS=336
# newest | relevance | alternate (see config.js). Default alternates by hour.
SEARCH_SORT=alternate
